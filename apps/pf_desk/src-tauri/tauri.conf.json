{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParcFerme",
  "version": "0.2.0",
  "identifier": "cc.parcferme.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ParcFerme",
        "width": 420,
        "height": 600,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["parcferme"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/viik2k/parcferme-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "TODO_REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
